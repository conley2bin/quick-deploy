+  /* Clipboard delivery owns one ladder: the async Clipboard API on a secure
+   * origin, the legacy execCommand textarea handoff where that API does not
+   * exist, and a manual-copy error when the browser refuses both.
+   *
+   * Codoxear is routinely opened over plain http:// on a LAN or tailnet address
+   * (http://100.x.y.z:8743). Those origins are not secure contexts, so
+   * navigator.clipboard does not exist there at all — gating copy on it made
+   * every copy button fail on a phone while the text sat on screen.
+   * execCommand("copy") is gated on a user gesture, not on a secure origin, so
+   * it carries the insecure case. It dies once transient activation expires
+   * (measured in Chrome 152: true inside the first seconds after the tap, false
+   * at 8 s), which is why the final error names the manual path instead of
+   * claiming a missing capability.
+   */
+
+  const CLIPBOARD_MANUAL_MESSAGE = "this browser blocked clipboard access — long-press the text and choose Copy";
+
+  function clipboardNavigator(windowTarget, navigatorTarget) {
+    if (navigatorTarget) return navigatorTarget;
+    if (typeof navigator !== "undefined" && navigator) return navigator;
+    return windowTarget && windowTarget.navigator ? windowTarget.navigator : null;
+  }
+
+  function clipboardSecureOrigin(windowTarget) {
+    return Boolean(windowTarget && windowTarget.isSecureContext === true);
+  }
+
+  function asyncClipboard(windowTarget, navigatorTarget) {
+    if (!clipboardSecureOrigin(windowTarget)) return null;
+    const nav = clipboardNavigator(windowTarget, navigatorTarget);
+    const clipboard = nav && nav.clipboard;
+    if (!clipboard || typeof clipboard.writeText !== "function") return null;
+    return clipboard;
+  }
+
+  // The scratch textarea must stay laid out: WebKit refuses to copy a selection
+  // it has not rendered, so it is parked offscreen and made transparent instead
+  // of display:none. readonly keeps the mobile keyboard down, aria-hidden and
+  // tabindex -1 keep it out of the accessibility tree and tab order.
+  function legacyCopyTextarea(documentTarget, text) {
+    const body = documentTarget && documentTarget.body;
+    if (!body || typeof documentTarget.createElement !== "function" || typeof documentTarget.execCommand !== "function") return false;
+    const value = String(text == null ? "" : text);
+    const previousFocus = documentTarget.activeElement || null;
+    const holder = documentTarget.createElement("textarea");
+    holder.value = value;
+    holder.setAttribute("readonly", "");
+    holder.setAttribute("aria-hidden", "true");
+    holder.setAttribute("tabindex", "-1");
+    const style = holder.style;
+    style.position = "fixed";
+    style.top = "0";
+    style.left = "0";
+    style.width = "1px";
+    style.height = "1px";
+    style.padding = "0";
+    style.border = "none";
+    style.outline = "none";
+    style.boxShadow = "none";
+    style.background = "transparent";
+    style.color = "transparent";
+    style.fontSize = "12pt";
+    style.opacity = "0";
+    let copied = false;
+    try {
+      body.appendChild(holder);
+      holder.focus({ preventScroll: true });
+      holder.select();
+      // iOS ignores select() on a programmatically focused textarea unless the
+      // range is also set explicitly.
+      holder.setSelectionRange(0, value.length);
+      copied = documentTarget.execCommand("copy") === true;
+    } catch (err) {
+      copied = false;
+    } finally {
+      if (typeof holder.remove === "function") holder.remove();
+      else if (typeof body.removeChild === "function") body.removeChild(holder);
+      if (previousFocus && previousFocus !== holder && typeof previousFocus.focus === "function") {
+        try {
+          previousFocus.focus({ preventScroll: true });
+        } catch (err) {}
+      }
+    }
+    return copied;
+  }
+
+  function manualCopyError() {
+    const error = new Error(CLIPBOARD_MANUAL_MESSAGE);
+    error.name = "ClipboardError";
+    error.code = "clipboard_manual_copy_required";
+    return error;
+  }
+
+  // Resolves with the path that delivered the text ("clipboard" or
+  // "execCommand"), and rejects only when the browser refused both — the caller
+  // then reports the manual instruction instead of a capability fact.
+  async function copyToClipboard(text, options = {}) {
+    const value = String(text == null ? "" : text);
+    const windowTarget = options.windowTarget || (typeof window !== "undefined" ? window : null);
+    const documentTarget = options.documentTarget || (typeof document !== "undefined" ? document : null);
+    const clipboard = asyncClipboard(windowTarget, options.navigatorTarget);
+    if (clipboard) {
+      try {
+        await clipboard.writeText(value);
+        return "clipboard";
+      } catch (err) {
+        // A refused permission still leaves the gesture-scoped path open, so
+        // this is a fall-through, not a terminal failure.
+      }
+    }
+    if (legacyCopyTextarea(documentTarget, value)) return "execCommand";
+    throw manualCopyError();
+  }
+
+export { CLIPBOARD_MANUAL_MESSAGE, copyToClipboard, legacyCopyTextarea };
