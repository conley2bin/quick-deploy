# conley 的 tmux 定制基线 —— 相对 gpakosz/.tmux 默认的全部个人改动
#
# 本文件由 install.sh 在首次安装时播种为 ~/.tmux.conf.local（已存在则保留
# 不动）。只记录真正的个人偏好，不复制上游模板的几百行注释；全部可用选项
# 见上游模板 ~/.tmux/.tmux.conf.local（安装后可用 diff 对照）。

# 开启鼠标模式：点击切窗格、拖边框调大小、滚轮翻历史
set -g mouse on

# Ghostty 与 tmux 的扩展键：真正依赖 extended-keys 的是 C-M-= / C-M-+
# （没有传统编码的按键）。tmux ≥3.5 只有在终端具备 extkeys 特性时才会
# 真正向终端发出请求（CSI > 4 ; 2 m），Ghostty 收到请求后才会发送
# ghostty/install.sh 里写死的 csi:61;7u / csi:43;7u。本机 xterm-ghostty 的
# terminfo 没有 Eneks 能力，tmux 的默认表也不含 Ghostty —— 不加下一行，
# extended-keys 设 on 还是 always 都不会发出请求，C-M-=/+ 失灵且 Ghostty
# 一直提示 “tmux extended-keys is off”（与服务器从哪个终端启动无关）。
set -as terminal-features ',xterm-ghostty:extkeys'
# 无条件开启（本机只用 Ghostty）。gpakosz 只在「启动 tmux 服务器那一刻
# TERM_PROGRAM=ghostty」时设 always，从 VS Code/SSH 等上下文启动的服务器会
# 被设成 off；本行位于其条件判断之后（主配置在 line 164 才 source 本文件），
# 覆盖为 always —— 与 gpakosz 现代分支取值一致，扩展键也会无条件转发给
# pane 内应用，即使应用没有主动请求 modifyOtherKeys。
set -g extended-keys always
# 精简 Oh my tmux! 状态栏：左侧只显示 session 名，移除系统 uptime；右侧
# 移除电池/电源信息，并把用户名、主机名与时间、日期放在同一分段中。session
# 与右侧时间同为浅灰字、深灰底、无文字属性。
tmux_conf_theme_status_left=" ❐ #S "
tmux_conf_theme_status_left_fg="#8a8a8a"
tmux_conf_theme_status_left_bg="#080808"
tmux_conf_theme_status_left_attr="none"
tmux_conf_theme_status_right=" #{prefix}#{mouse}#{pairing}#{synchronized} %R · %d %b · #{username}#{root}@#{hostname} "
tmux_conf_theme_status_right_fg="$tmux_conf_theme_colour_12"
tmux_conf_theme_status_right_bg="$tmux_conf_theme_colour_15"
tmux_conf_theme_status_right_attr="none"

# 普通未选中 window 的空闲基线是深色字、灰色块背景；选中 window 不再用
# 蓝色块，而是在色块左右末端各放两个整格实心的 #0077aa 蓝色竖条（██，
# 各向内延伸 2 格；fg/bg 同设蓝，字体即使留缝隙也全蓝不漏底色）。选中与
# error 走正交视觉通道（竖条 vs 背景），error 红底不再吞掉选中标识；呼吸
# 始终放在背景色块上，两侧蓝色竖条不呼吸。下面的 #!important 直写格式
# 最终接管 last/activity/bell 的渲染，因此不再声明这些覆盖变量：last 和
# activity 不改变背景或强调；bell 只保留黄色前景和 ! 标记；zoom 保留 Z。
# 这里使用当前默认调色板的字面值，而不引用 colour_*：本地精简配置没有
# 重新声明整套调色板，source 阶段引用未定义 shell 变量会展开为空。
tmux_conf_theme_window_status_fg="#080808"
tmux_conf_theme_window_status_bg="#bcbcbc"
tmux_conf_theme_window_status_attr="none"

# The Pi extension writes these window-scoped options only while work is active
# or a model/provider error is latched. The Oh My Tmux generator expands its
# theme variables before tmux can evaluate nested formats, so this narrow
# important override keeps the dark edge cells, fixed idle backgrounds,
# bell/zoom markers, steady red errors, and breathing colors in one place.
# Selection is a pair of full-block #0077aa bars at both ends of the tab
# (fg and bg both blue, so even font-rendered gaps never show the block
# color) — a visual channel orthogonal to the background, so a selected tab
# with a latched error shows the red block plus solid blue ends instead of
# losing the selection cue. The bars never breathe and never change color;
# breathing only ever moves the background block.
setw -g window-status-format '#[fg=#{?@quick_deploy_pi_error,#ffffff,#{?window_bell_flag,#ffff00,#080808}},bg=#{?@quick_deploy_pi_error,#d70000,#{?@quick_deploy_pi_active,#{@quick_deploy_pi_bg},#bcbcbc}},none] #{window_index} #{window_name}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,} #[fg=#080808,bg=#080808]' #!important
setw -g window-status-current-format '#[fg=#0077aa,bg=#0077aa,none]██#[fg=#{?@quick_deploy_pi_error,#ffffff,#{?window_bell_flag,#ffff00,#080808}},bg=#{?@quick_deploy_pi_error,#d70000,#{?@quick_deploy_pi_active,#{@quick_deploy_pi_bg},#bcbcbc}},bold] #{window_index} #{window_name}#{?window_bell_flag,!,}#{?window_zoomed_flag,Z,} #[fg=#0077aa,bg=#0077aa,none]██#[fg=#080808,bg=#080808]' #!important

# 普通 pane 中滚轮每格滚动 1 行：首次向上滚时进入 copy-mode，随后由
# copy-mode 的 WheelUp/DownPane 绑定按 history-limit 滚动。应用若主动开启
# mouse reporting（mouse_any_flag），仍把滚轮原样交给应用处理。
bind -T root WheelUpPane if-shell -F '#{mouse_any_flag}' \
  'send-keys -M' \
  'copy-mode -e; send-keys -X -N 1 scroll-up'
bind -T copy-mode WheelUpPane   send-keys -X -N 1 scroll-up
bind -T copy-mode WheelDownPane send-keys -X -N 1 scroll-down
bind -T copy-mode-vi WheelUpPane   send-keys -X -N 1 scroll-up
bind -T copy-mode-vi WheelDownPane send-keys -X -N 1 scroll-down

# 鼠标拖选复制后不退出 copy-mode、不跳回 pane 底部：tmux 默认（gpakosz 未
# 覆盖）的 copy-mode MouseDragEnd1Pane = copy-pipe-and-cancel，-cancel 在
# 复制进缓冲区后立即退出 copy-mode，视图跳回 pane 实时位置（Pi 提示符），
# 拖选前滚上去的位置全部丢失。改为复制后仅清除选区、留在 copy-mode：
# 复制到的内容仍进 tmux 缓冲区，视图保持当前滚动位置；看完历史按 q / Esc
# 再回底部。copy-mode-vi 表同样覆盖（mode-keys 切到 vi 时生效）。
bind -T copy-mode    MouseDragEnd1Pane send-keys -X copy-selection-no-clear \; send-keys -X clear-selection
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-no-clear \; send-keys -X clear-selection

# Oh my tmux! 默认额外把 Ctrl+a 配成第二前缀；取消该绑定，只保留 Ctrl+b。
set -gu prefix2
unbind C-a
bind-key DC kill-window

# Ctrl+Alt+←/→ 直接切换 window（不需要前缀键）。到头环绕
# （previous/next-window 默认环绕）。
#
# Ghostty 默认把 ctrl+alt+arrow 绑给 goto_split；仅靠“无 split 时似乎会
# 透传”的当前表现不够稳定。fresh-install/modules/ghostty/install.sh 因此显式
# unbind 左右两个键，保证它们编码后送入 pty。
# unbind 后 Ghostty 按传统编码（CSI 1;7D / 1;7C）发送这两个组合键，
# tmux 无需 extended-keys 也能识别为 C-M-Left/C-M-Right —— 与 C-M-=/+
# 依赖 CSI-u 的路径不同。
#
# 代价：Ghostty 自己的 split 不再能用 Ctrl+Alt+←/→ 切；本机不用
# Ghostty split，键的所有权明确交给 tmux window，避免两层抢同一按键。
bind -n C-M-Left  previous-window
bind -n C-M-Right next-window

# Ctrl+Alt+= / Ctrl+Alt++ 新建 window：先问名字（回车留空 = 不命名，按进程
# 自动改名），开在当前 pane 的目录。Ghostty 为这两个物理组合键显式发送
# 固定 CSI-u 序列，tmux 分别识别为 C-M-= 与 C-M-+，避免依赖终端对符号键
# 修饰符的隐式编码。
#
# 行尾的 #!important 不能删：gpakosz 的 _apply_bindings 会把所有 new-window
# 绑定里的 -c '#{pane_current_path}' 剥掉（retain_current_path=false 的语义），
# 以 #!important 结尾的 bind 行会在改写完成后被 _apply_important 重新 source，
# 这是上游提供的逃生门。
bind -n C-M-= command-prompt -p "window name:" "new-window -c '#{pane_current_path}' -n '%%'" #!important
bind -n C-M-+ command-prompt -p "window name:" "new-window -c '#{pane_current_path}' -n '%%'" #!important
