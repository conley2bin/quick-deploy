+/** Fail closed unless the originating pane's effective policy enables passthrough. */
+export function probeTmuxPassthrough(env: Environment, run: TmuxCommand = spawnSync): boolean {
+	const pane = env.TMUX_PANE?.trim();
+	if (!pane || !/^%\d+$/u.test(pane)) return false;
+	try {
+		const result = run("tmux", ["show-options", "-Apv", "-t", pane, "allow-passthrough"], {
+			encoding: "utf8",
+			timeout: 1_000,
+		});
+		return result.status === 0 && /^(on|all|yes|true|1)$/iu.test(result.stdout?.trim() ?? "");
+	} catch {
+		return false;
+	}
+}
 
