+			return { ...received, notice: provenanceNotice(proof.reason) };
+		}
+		if (!builtinLocal) return { ...received, notice: provenanceNotice("tool-source-unverified", proof.original.canonicalPath) };
+		try {
+			const current = await captureResolved(proof.original.resolvedPath);
+			const related = await relation(current, block);
+			if (generation !== this.generation) return { ...received, notice: provenanceNotice("capture-unavailable", proof.original.canonicalPath) };
+			if (current.canonicalPath !== proof.original.canonicalPath || current.identityHash !== proof.original.identityHash
+				|| current.sourceHash !== proof.original.sourceHash || current.mimeType !== proof.original.mimeType
+				|| current.bytes.length !== proof.original.bytes || related.blockHash !== proof.blockHash
+				|| related.receivedHash !== proof.receivedHash || related.receivedMime !== proof.receivedMime || !related.verified) {
+				return { ...received, notice: provenanceNotice("source-changed", proof.original.canonicalPath) };
+			}
+			return {
+				data: current.bytes.toString("base64"),
+				mimeType: current.mimeType,
+				path: current.canonicalPath,
+				expectedHash: current.sourceHash,
+			};
+		} catch (error) {
+			const reason = error instanceof CaptureError && error.reason === "source-missing" ? "source-missing" : "source-changed";
+			return { ...received, notice: provenanceNotice(reason, proof.original.canonicalPath) };
+		}
+	}
+
+	reset(): void {
+		this.generation++;
+		this.pending.clear();
+		this.results.clear();
+		this.frozenBytes = 0;
+	}
+
+	private enqueue<T>(operation: () => Promise<T>): Promise<T> {
+		const next = this.serial.then(operation, operation);
+		this.serial = next.then(() => undefined, () => undefined);
+		return next;
+	}
+
+	private setResult(evidence: ReadDisplayEvidence): void {
+		while (this.results.size >= MAX_TRACKED_READS) {
+			const oldest = this.results.keys().next().value as string | undefined;
+			if (!oldest) break;
+			const removed = this.results.get(oldest);
+			this.results.delete(oldest);
+			if (removed?.ownsFrozenBytes && removed.capture) this.frozenBytes -= removed.capture.bytes.length;
+		}
+		this.results.set(this.key(evidence.toolCallId, evidence.blockIndex, evidence.blockHash), evidence);
+	}
+
+	private ensureRecordCapacity(): void {
+		while (this.pending.size + this.results.size >= MAX_TRACKED_READS) {
+			const oldest = this.pending.keys().next().value as string | undefined;
+			if (oldest) { this.dropPending(oldest); continue; }
+			const result = this.results.keys().next().value as string | undefined;
+			if (!result) break;
+			const removed = this.results.get(result);
+			this.results.delete(result);
+			if (removed?.ownsFrozenBytes && removed.capture) this.frozenBytes -= removed.capture.bytes.length;
+		}
+	}
+
+	private dropPending(toolCallId: string): void {
+		const pending = this.pending.get(toolCallId);
+		this.pending.delete(toolCallId);
+		if (pending) this.releasePending(pending);
+	}
+
+	private releasePending(pending: PendingRead): void {
+		if (pending.kind === "captured") this.frozenBytes -= pending.capture.bytes.length;
+	}
+
+	private key(toolCallId: string, blockIndex: number, blockHash: string): string {
+		return `${toolCallId}\u0000${blockIndex}\u0000${HASH.test(blockHash) ? blockHash : "invalid"}`;
+	}
+}
