+			return {
+				...base,
+				status: "verified-local-original",
+				original: {
+					resolvedPath: evidence.capture.resolvedPath,
+					canonicalPath: evidence.capture.canonicalPath,
+					identityHash: evidence.capture.identityHash,
+					sourceHash: evidence.capture.sourceHash,
+					mimeType: evidence.capture.mimeType,
+					bytes: evidence.capture.bytes.length,
+					width: entry.width,
+					height: entry.height,
+				},
+			};
+		}
+		return { ...base, status: "unverified", reason: evidence.reason ?? "result-mismatch" };
+	}
+
+	restore(entry: PreviewEntry, block: ImageBlock, builtinLocal: boolean): Promise<RestoredReadSource> {
+		const generation = this.generation;
+		return this.enqueue(() => this.restoreNow(entry, block, builtinLocal, generation));
+	}
+
+	private async restoreNow(entry: PreviewEntry, block: ImageBlock, builtinLocal: boolean, generation: number): Promise<RestoredReadSource> {
+		const proof = entry.readProvenance!;
+		const received = {
+			data: block.data,
+			mimeType: block.mimeType,
+			path: "attached image",
+			expectedHash: proof.receivedHash,
+		};
