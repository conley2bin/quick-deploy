+		let frozenTransferred = false;
+		for (const { block, blockIndex } of blocks) {
+			let related: Awaited<ReturnType<typeof relation>> | undefined;
+			try { if (capture) related = await relation(capture, block); } catch { /* Recorded as mismatch below. */ }
+			if (generation !== this.generation) return;
+			const status = capture && !reason && related?.verified && !frozenTransferred ? "verified-local-original" : "unverified";
+			const evidence: ReadDisplayEvidence = {
+				status,
+				toolCallId,
+				blockIndex,
+				blockHash: related?.blockHash ?? sha256(block.data),
+				receivedHash: related?.receivedHash ?? sha256(Buffer.from(block.data, "base64")),
+				receivedMime: related?.receivedMime ?? normalizedMime(block.mimeType) ?? "image/png",
+				reason: status === "unverified" ? reason ?? "result-mismatch" : undefined,
+				capture: status === "verified-local-original" ? capture : undefined,
+				ownsFrozenBytes: status === "verified-local-original",
+			};
+			if (evidence.ownsFrozenBytes) frozenTransferred = true;
+			this.setResult(evidence);
+		}
+		if (!frozenTransferred) this.releasePending(pending);
+	}
+
