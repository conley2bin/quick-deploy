index 0000000..22621e6
--- /dev/null
+++ b/src/provenance.ts
@@ -0,0 +1,376 @@
+import { createHash } from "node:crypto";
+import { lstat, readFile, realpath, stat } from "node:fs/promises";
+import { homedir } from "node:os";
+import { isAbsolute, normalize, resolve } from "node:path";
+import type { ToolInfo } from "@earendil-works/pi-coding-agent";
+import sharp from "sharp";
+import { MAX_INPUT_BYTES, MAX_PIXELS, type OriginalMime, validateEncodedImageInput } from "./loader.ts";
+import type { PreviewEntry, ReadProvenance, ReadProvenanceReason } from "./transcript-entry.ts";
+
+const MAX_TRACKED_READS = 64;
+const MAX_FROZEN_BYTES = 64 * 1024 * 1024;
+const HASH = /^[a-f0-9]{64}$/u;
+
+type FileCapture = {
+	resolvedPath: string;
+	canonicalPath: string;
+	identityHash: string;
+	sourceHash: string;
+	mimeType: OriginalMime;
+	bytes: Buffer;
+};
+type PendingRead =
+	| { kind: "captured"; capture: FileCapture }
+	| { kind: "unverified"; reason: ReadProvenanceReason };
+export type ReadDisplayEvidence = {
+	status: "verified-local-original" | "unverified";
+	toolCallId: string;
+	blockIndex: number;
+	blockHash: string;
+	receivedHash: string;
+	receivedMime: OriginalMime;
+	reason?: ReadProvenanceReason;
+	capture?: FileCapture;
+	ownsFrozenBytes?: boolean;
+};
+export type RestoredReadSource = {
+	data: string;
+	mimeType: string;
+	path: string;
+	expectedHash: string;
+	notice?: string;
+};
+
+type ImageBlock = { type: "image"; data: string; mimeType: string };
+
+class CaptureError extends Error {
+	constructor(readonly reason: ReadProvenanceReason) { super(reason); }
+}
+
+function sha256(value: string | Buffer): string {
+	return createHash("sha256").update(value).digest("hex");
+}
+
+function originalMime(format?: string): OriginalMime | undefined {
+	if (format === "png") return "image/png";
+	if (format === "jpeg") return "image/jpeg";
+	if (format === "webp") return "image/webp";
+	return undefined;
+}
+
+function resolveInputPath(raw: string, cwd: string): string {
+	const trimmed = raw.trim().replace(/^@/u, "");
+	if (!trimmed) throw new CaptureError("capture-unavailable");
+	const expanded = trimmed === "~" || trimmed.startsWith("~/") ? `${homedir()}${trimmed.slice(1)}` : trimmed;
+	return normalize(isAbsolute(expanded) ? expanded : resolve(cwd, expanded));
+}
+
+function statFingerprint(value: Awaited<ReturnType<typeof stat>> | Awaited<ReturnType<typeof lstat>>): string {
+	const candidate = value as unknown as {
+		dev: bigint | number; ino: bigint | number; mode: bigint | number; size: bigint | number;
+		mtimeNs?: bigint; ctimeNs?: bigint; mtimeMs: bigint | number; ctimeMs: bigint | number;
+	};
+	return [candidate.dev, candidate.ino, candidate.mode, candidate.size,
+		candidate.mtimeNs ?? candidate.mtimeMs, candidate.ctimeNs ?? candidate.ctimeMs].map(String).join(":");
+}
+
+async function captureResolved(resolvedPath: string): Promise<FileCapture> {
+	try {
+		const linkBefore = await lstat(resolvedPath, { bigint: true });
+		const canonicalPath = await realpath(resolvedPath);
+		const targetBefore = await stat(canonicalPath, { bigint: true });
+		if (!targetBefore.isFile()) throw new CaptureError("capture-unavailable");
+		if (targetBefore.size > BigInt(MAX_INPUT_BYTES)) throw new CaptureError("capture-unavailable");
+		const bytes = await readFile(canonicalPath);
+		if (bytes.length > MAX_INPUT_BYTES) throw new CaptureError("capture-unavailable");
+		const [linkAfter, targetAfter, canonicalAfter] = await Promise.all([
+			lstat(resolvedPath, { bigint: true }),
+			stat(canonicalPath, { bigint: true }),
+			realpath(resolvedPath),
+		]);
+		const beforeIdentity = `${statFingerprint(linkBefore)}\u0000${statFingerprint(targetBefore)}`;
+		const afterIdentity = `${statFingerprint(linkAfter)}\u0000${statFingerprint(targetAfter)}`;
+		if (canonicalAfter !== canonicalPath || beforeIdentity !== afterIdentity || targetAfter.size !== BigInt(bytes.length)) {
+			throw new CaptureError("source-changed");
+		}
+		const metadata = await sharp(bytes, { limitInputPixels: MAX_PIXELS, failOn: "error" }).metadata();
+		const mimeType = originalMime(metadata.format);
+		if (!mimeType) throw new CaptureError("capture-unavailable");
+		return {
+			resolvedPath,
+			canonicalPath,
+			identityHash: sha256(`${resolvedPath}\u0000${canonicalPath}\u0000${afterIdentity}`),
+			sourceHash: sha256(bytes),
+			mimeType,
+			bytes,
+		};
+	} catch (error) {
+		if (error instanceof CaptureError) throw error;
+		const code = error && typeof error === "object" && "code" in error ? String((error as { code?: unknown }).code) : "";
+		throw new CaptureError(code === "ENOENT" || code === "ENOTDIR" ? "source-missing" : "capture-unavailable");
+	}
+}
+
+async function captureInput(raw: string, cwd: string): Promise<FileCapture> {
+	return captureResolved(resolveInputPath(raw, cwd));
+}
+
+function imageBlocks(content: readonly unknown[]): Array<{ block: ImageBlock; blockIndex: number }> {
+	return content.flatMap((value, blockIndex) => value && typeof value === "object"
+		&& (value as Partial<ImageBlock>).type === "image"
+		&& typeof (value as Partial<ImageBlock>).data === "string"
+		&& typeof (value as Partial<ImageBlock>).mimeType === "string"
+		? [{ block: value as ImageBlock, blockIndex }]
+		: []);
+}
+
+function normalizedMime(value: string): OriginalMime | undefined {
+	const mime = value.split(";", 1)[0]!.trim().toLowerCase();
+	if (mime === "image/png" || mime === "image/jpeg" || mime === "image/webp") return mime;
+	return undefined;
+}
+
+async function relation(capture: FileCapture, block: ImageBlock): Promise<{ blockHash: string; receivedHash: string; receivedMime: OriginalMime; verified: boolean }> {
+	const receivedMime = normalizedMime(block.mimeType);
+	if (!receivedMime) throw new CaptureError("result-mismatch");
+	try { validateEncodedImageInput(block.data, receivedMime); } catch { throw new CaptureError("result-mismatch"); }
+	const received = Buffer.from(block.data, "base64");
+	const base = { blockHash: sha256(block.data), receivedHash: sha256(received), receivedMime };
+	if (receivedMime === capture.mimeType && received.equals(capture.bytes)) return { ...base, verified: true };
+	const { resizeImage } = await import("@earendil-works/pi-coding-agent");
+	const resized = await resizeImage(capture.bytes, capture.mimeType);
+	return { ...base, verified: Boolean(resized && resized.mimeType === receivedMime && resized.data === block.data) };
+}
+
+export function isBuiltinLocalRead(tools: readonly ToolInfo[]): boolean {
+	const matches = tools.filter((tool) => tool.name === "read");
+	if (matches.length !== 1) return false;
+	const source = matches[0]!.sourceInfo;
+	return source.path === "<builtin:read>" && source.source === "builtin"
+		&& source.scope === "temporary" && source.origin === "top-level" && source.baseDir === undefined;
+}
+
+export function provenanceNotice(reason: ReadProvenanceReason, path?: string): string {
+	const target = path ? ` for ${path}` : "";
+	const detail: Record<ReadProvenanceReason, string> = {
+		"tool-source-unverified": "the read tool is not the standard builtin local reader",
+		"capture-unavailable": "a bounded local original could not be frozen at tool call",
+		"source-missing": "the verified local source is missing",
+		"source-changed": "the verified local source changed",
+		"result-mismatch": "the received image does not match the local original or Pi resize",
+	};
+	return `Original resolution unavailable/unverified${target}: ${detail[reason]}. Displaying received pixels.`;
+}
+
+export class ReadOriginalTracker {
+	private readonly pending = new Map<string, PendingRead>();
+	private readonly results = new Map<string, ReadDisplayEvidence>();
+	private frozenBytes = 0;
+	private serial = Promise.resolve();
+	private generation = 0;
+
+	begin(toolCallId: string, input: Record<string, unknown>, cwd: string, builtinLocal: boolean): Promise<void> {
+		const generation = this.generation;
+		return this.enqueue(() => this.beginNow(toolCallId, input, cwd, builtinLocal, generation));
+	}
+
+	private async beginNow(toolCallId: string, input: Record<string, unknown>, cwd: string, builtinLocal: boolean, generation: number): Promise<void> {
+		if (generation !== this.generation) return;
+		this.dropPending(toolCallId);
+		this.ensureRecordCapacity();
+		if (!builtinLocal || typeof input.path !== "string") {
+			this.pending.set(toolCallId, { kind: "unverified", reason: builtinLocal ? "capture-unavailable" : "tool-source-unverified" });
+			return;
+		}
+		try {
+			const capture = await captureInput(input.path, cwd);
+			if (generation !== this.generation) return;
+			if (this.frozenBytes + capture.bytes.length > MAX_FROZEN_BYTES) {
+				this.pending.set(toolCallId, { kind: "unverified", reason: "capture-unavailable" });
+				return;
+			}
+			this.frozenBytes += capture.bytes.length;
+			this.pending.set(toolCallId, { kind: "captured", capture });
+		} catch (error) {
+			this.pending.set(toolCallId, { kind: "unverified", reason: error instanceof CaptureError ? error.reason : "capture-unavailable" });
+		}
+	}
+
+	finish(toolCallId: string, content: readonly unknown[], builtinLocal: boolean, successful = true): Promise<void> {
+		const generation = this.generation;
+		return this.enqueue(() => this.finishNow(toolCallId, content, builtinLocal, successful, generation));
+	}
+
+	private async finishNow(toolCallId: string, content: readonly unknown[], builtinLocal: boolean, successful: boolean, generation: number): Promise<void> {
+		if (generation !== this.generation) return;
+		const pending = this.pending.get(toolCallId);
+		this.pending.delete(toolCallId);
+		if (!pending) return;
+		const blocks = imageBlocks(content);
+		if (!blocks.length) { this.releasePending(pending); return; }
+
+		let capture = pending.kind === "captured" ? pending.capture : undefined;
+		let reason = pending.kind === "unverified" ? pending.reason : undefined;
+		if (!successful) reason = "result-mismatch";
+		else if (capture && !builtinLocal) reason = "tool-source-unverified";
+		if (capture && !reason) {
+			try {
+				const current = await captureResolved(capture.resolvedPath);
+				if (generation !== this.generation) return;
+				if (current.canonicalPath !== capture.canonicalPath || current.identityHash !== capture.identityHash
+					|| current.sourceHash !== capture.sourceHash || current.mimeType !== capture.mimeType) reason = "source-changed";
+			} catch (error) {
+				reason = error instanceof CaptureError && error.reason === "source-missing" ? "source-missing" : "source-changed";
+			}
+		}
+
+		let frozenTransferred = false;
+		for (const { block, blockIndex } of blocks) {
+			let related: Awaited<ReturnType<typeof relation>> | undefined;
+			try { if (capture) related = await relation(capture, block); } catch { /* Recorded as mismatch below. */ }
+			if (generation !== this.generation) return;
+			const status = capture && !reason && related?.verified && !frozenTransferred ? "verified-local-original" : "unverified";
+			const evidence: ReadDisplayEvidence = {
+				status,
+				toolCallId,
+				blockIndex,
+				blockHash: related?.blockHash ?? sha256(block.data),
+				receivedHash: related?.receivedHash ?? sha256(Buffer.from(block.data, "base64")),
+				receivedMime: related?.receivedMime ?? normalizedMime(block.mimeType) ?? "image/png",
+				reason: status === "unverified" ? reason ?? "result-mismatch" : undefined,
+				capture: status === "verified-local-original" ? capture : undefined,
+				ownsFrozenBytes: status === "verified-local-original",
+			};
+			if (evidence.ownsFrozenBytes) frozenTransferred = true;
+			this.setResult(evidence);
+		}
+		if (!frozenTransferred) this.releasePending(pending);
+	}
+
+	consume(toolCallId: string, blockIndex: number, blockHash: string): ReadDisplayEvidence | undefined {
+		const key = this.key(toolCallId, blockIndex, blockHash);
+		const evidence = this.results.get(key);
+		if (!evidence) return undefined;
+		this.results.delete(key);
+		if (evidence.ownsFrozenBytes && evidence.capture) this.frozenBytes -= evidence.capture.bytes.length;
+		return evidence;
+	}
+
+	persist(evidence: ReadDisplayEvidence, entry: PreviewEntry): ReadProvenance {
+		const base = {
+			version: 1 as const,
+			status: evidence.status,
+			toolCallId: evidence.toolCallId,
+			blockIndex: evidence.blockIndex,
+			blockHash: evidence.blockHash,
+			receivedHash: evidence.receivedHash,
+			receivedMime: evidence.receivedMime,
+		};
