MAX_INPUT = 65536
MAX_PREPARE_MS = 45000
MAX_INVENTORY_OUTPUT = 1024 * 1024
MAX_DIAGNOSTIC_OUTPUT = 4096
BROWSER_QUERY_TIMEOUT_SECONDS = 4
BROWSER_LAUNCH_GRACE_SECONDS = 5
GUI_KEYS = ("DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
            "DBUS_SESSION_BUS_ADDRESS", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE")
PID_RE = re.compile(r"Master running \(pid=(\d+)\)")
SS_PID_RE = re.compile(r"\bpid=(\d+)\b")
SOCKET_NAME_RE = re.compile(r"m-[0-9a-f]{24}\.sock")
DESKTOP_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\.desktop")
BROWSER_COMMANDS = {
    "google-chrome.desktop": ("google-chrome-stable", ("--new-window",)),
    "google-chrome-beta.desktop": ("google-chrome-beta", ("--new-window",)),
    "google-chrome-unstable.desktop": ("google-chrome-unstable", ("--new-window",)),
    "chromium.desktop": ("chromium", ("--new-window",)),
    "chromium-browser.desktop": ("chromium-browser", ("--new-window",)),
    "chromium_chromium.desktop": ("chromium", ("--new-window",)),
    "firefox.desktop": ("firefox", ("--new-window",)),
    "firefox_firefox.desktop": ("firefox", ("--new-window",)),
    "firefox-esr.desktop": ("firefox", ("--new-window",)),
    "microsoft-edge.desktop": ("microsoft-edge-stable", ("--new-window",)),
    "brave-browser.desktop": ("brave-browser", ("--new-window",)),
