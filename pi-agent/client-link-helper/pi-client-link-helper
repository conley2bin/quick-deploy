#!/usr/bin/env python3
"""Y9000p-side, one-request JSON link opener. No Pi/server-side routing here."""

import errno
import fcntl
import hashlib
import ipaddress
import json
import os
from pathlib import Path, PurePosixPath
import re
import select
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
from urllib.parse import quote, urlsplit


SSH_ALIAS = "conley-company"
REMOTE_CODE = "ssh-remote+conley-company"
MAX_INPUT = 65536
MAX_PREPARE_MS = 45000
MAX_INVENTORY_OUTPUT = 1024 * 1024
MAX_DIAGNOSTIC_OUTPUT = 4096
GUI_KEYS = ("DISPLAY", "XAUTHORITY", "WAYLAND_DISPLAY", "XDG_RUNTIME_DIR",
            "DBUS_SESSION_BUS_ADDRESS", "XDG_CURRENT_DESKTOP", "XDG_SESSION_TYPE")
PID_RE = re.compile(r"Master running \(pid=(\d+)\)")
SS_PID_RE = re.compile(r"\bpid=(\d+)\b")
SOCKET_NAME_RE = re.compile(r"m-[0-9a-f]{24}\.sock")


class LinkError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def fail(code, message):
    raise LinkError(code, message)


def live_group_members(group):
    """After KILL, wait for owned descendants to exit, not just the leader."""
    for entry in os.scandir("/proc"):
        if not entry.name.isdecimal():
            continue
        try:
            fields = Path(entry.path, "stat").read_bytes().decode("utf-8", errors="replace").rpartition(") ")[2].split()
            if len(fields) > 2 and int(fields[2]) == group and fields[0] not in ("Z", "X"):
                return True
        except (FileNotFoundError, ProcessLookupError, PermissionError, ValueError):
            continue
    return False


def run(argv, *, env=None, timeout=12, output_limit=MAX_DIAGNOSTIC_OUTPUT):
    """No shell/inherited stdin; distinguish complete bounded output from overflow."""
    with tempfile.TemporaryFile() as output:
        try:
            process = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=output,
                                       stderr=subprocess.STDOUT, env=env, start_new_session=True)
        except OSError as error:
            fail("command_start_failed", f"{argv[0]}: {error}")
        try:
            status = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            group = process.pid
            try:
                os.killpg(group, signal.SIGTERM)
            except ProcessLookupError:
                pass
            grace_end = time.monotonic() + 1
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                pass
            remaining = grace_end - time.monotonic()
            if remaining > 0:
                time.sleep(remaining)
            # The leader may have exited while another member ignored TERM.
            try:
                os.killpg(group, signal.SIGKILL)
            except ProcessLookupError:
                pass
            try:
                process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                fail("command_timeout", f"{argv[0]} did not reap after SIGKILL")
            cleanup_end = time.monotonic() + 1
            while live_group_members(group) and time.monotonic() < cleanup_end:
                time.sleep(0.01)
            if live_group_members(group):
                fail("command_timeout", f"{argv[0]} left owned descendants after SIGKILL")
            fail("command_timeout", f"{argv[0]} did not finish in {timeout}s")
        output.seek(0)
        raw = output.read(output_limit + 1)
        if len(raw) > output_limit:
            fail("command_output_overflow", f"{argv[0]} exceeded {output_limit} output bytes")
        text = raw.decode("utf-8", errors="replace").strip()
    return status, text


def checked(argv, code, *, env=None, timeout=12, output_limit=MAX_DIAGNOSTIC_OUTPUT):
    status, text = run(argv, env=env, timeout=timeout, output_limit=output_limit)
    if status:
        fail(code, f"{argv[0]} exited {status}: {text or 'no diagnostic'}")
    return text


def unique_pairs(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            fail("invalid_request", f"duplicate JSON key: {key}")
        result[key] = value
    return result


def parse_message(raw):
    try:
        return json.loads(raw.decode("utf-8"), object_pairs_hook=unique_pairs)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        fail("invalid_request", f"invalid UTF-8 JSON: {error}")


class Peer:
    """Bounded line framing on the live SSH stdin; EOF cannot authorize a launch."""
    def __init__(self):
        self.fd = sys.stdin.fileno()
        os.set_blocking(self.fd, False)
        self.poller = select.poll()
        self.poller.register(self.fd, select.POLLIN | select.POLLHUP | select.POLLERR)
        self.buffer = bytearray()
        self.eof = False

    def receive(self, wait_ms):
        for _, events in self.poller.poll(wait_ms):
            if events & select.POLLERR:
                fail("request_aborted", "SSH input channel failed")
            if events & (select.POLLIN | select.POLLHUP):
                chunk = os.read(self.fd, MAX_INPUT + 1)
                if chunk:
                    self.buffer.extend(chunk)
                else:
                    self.eof = True
        if len(self.buffer) > MAX_INPUT and b"\n" not in self.buffer[:MAX_INPUT + 1]:
            fail("invalid_request", "message exceeds 64 KiB")

    def line(self, deadline, phase):
        while True:
            end = self.buffer.find(b"\n")
            if end >= 0:
                if end + 1 > MAX_INPUT:
                    fail("invalid_request", "message exceeds 64 KiB")
                raw = bytes(self.buffer[:end])
                del self.buffer[:end + 1]
                return parse_message(raw)
            if self.eof:
                fail("request_aborted", f"SSH input closed before {phase}")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                fail("request_timeout", f"client preparation deadline expired before {phase}")
            self.receive(min(100, max(1, int(remaining * 1000))))

    def alive(self, deadline):
        if time.monotonic() >= deadline:
            fail("request_timeout", "client preparation deadline expired")
        self.receive(0)
        if self.eof:
            fail("request_aborted", "SSH input closed before COMMIT")
        if self.buffer:
            fail("invalid_commit", "message arrived before PREPARED or after COMMIT")


def request(peer):
    # Initial request itself is bounded even when a caller never sends newline.
    data = peer.line(time.monotonic() + MAX_PREPARE_MS / 1000, "request")
    if not isinstance(data, dict) or type(data.get("version")) is not int or data["version"] != 2 or data.get("phase") != "request":
        fail("invalid_request", "expected a version 2 request object")
    duration = data.get("prepareDeadlineMs")
    if type(duration) is not int or not 1 <= duration <= MAX_PREPARE_MS:
        fail("invalid_request", "prepareDeadlineMs must be 1..45000")
    deadline = time.monotonic() + duration / 1000
    peer.alive(deadline)
    action = data.get("action")
    if action == "open-web":
        if set(data) != {"version", "phase", "prepareDeadlineMs", "action", "url"} or not isinstance(data["url"], str):
            fail("invalid_request", "open-web requires only a string url")
    elif action == "open-file":
        if not {"version", "phase", "prepareDeadlineMs", "action", "path", "kind"} <= set(data) or not set(data) <= {"version", "phase", "prepareDeadlineMs", "action", "path", "kind", "line", "column"}:
            fail("invalid_request", "open-file requires path, kind, and optional line/column")
        if not isinstance(data["path"], str) or data["kind"] not in ("file", "directory"):
            fail("invalid_request", "path must be a string and kind must be file or directory")
        for name in ("line", "column"):
            if name in data and (type(data[name]) is not int or not 1 <= data[name] <= 2147483647):
                fail("invalid_request", f"{name} must be a positive integer")
        if "column" in data and "line" not in data:
            fail("invalid_request", "column requires line")
        if data["kind"] == "directory" and "line" in data:
            fail("invalid_request", "a directory cannot have a line/column")
    else:
        fail("unsupported_target", "action must be open-web or open-file")
    return data, deadline


def web_target(raw):
    if not raw or len(raw) > 8192 or any(ord(char) <= 32 or ord(char) == 127 or char == "\\" for char in raw):
        fail("unsupported_target", "URL contains whitespace/control/backslash or is too long")
    try:
        parsed = urlsplit(raw)
        host = parsed.hostname
        port = parsed.port
    except ValueError as error:
        fail("unsupported_target", f"invalid URL authority: {error}")
    if parsed.scheme not in ("http", "https") or not parsed.netloc or not host or parsed.username is not None or parsed.password is not None:
        fail("unsupported_target", "expected an http(s) URL with a host and no userinfo")
    if "%" in parsed.netloc or "@" in parsed.netloc:
        fail("unsupported_target", "escaped authority/userinfo is unsupported")
    if port == 0 or parsed.netloc.endswith(":"):
        fail("unsupported_target", "URL port must be a nonempty, nonzero number")
    # Browsers apply IDNA and nonstandard IPv4 number rules before connecting.
    # Only plain ASCII DNS syntax is permitted outside explicit IP/localhost forms;
    # otherwise a laptop-local listener could be opened as an 'external' URL.
    if not host.isascii() or host.endswith(".."):
        fail("unsupported_target", "browser-normalized host spelling is unsupported")
    canonical_host = host.lower().removesuffix(".")
    if canonical_host == "localhost":
        bind_host = "localhost"  # No IPv4-only success until both client families can be owned.
    else:
        try:
            ip = ipaddress.ip_address(host)
        except ValueError:
            numeric = re.fullmatch(r"(?:0x[0-9a-f]+|[0-9]+)(?:\.(?:0x[0-9a-f]+|[0-9]+))*", canonical_host)
            labels = canonical_host.split(".")
            dns = all(re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label)
                      and not label.startswith("xn--") for label in labels)
            if canonical_host.endswith(".localhost") or numeric or not dns:
                fail("unsupported_target", "ambiguous or unsupported browser authority")
            bind_host = None
        else:
            mapped = getattr(ip, "ipv4_mapped", None)
            effective_ip = mapped or ip
            if effective_ip.is_unspecified or (effective_ip.version == 4 and effective_ip.packed[0] == 0):
                fail("unsupported_target", "unspecified/zero-net address can reach a client-local service")
            bind_host = str(ip) if effective_ip.is_loopback else None
    return parsed, bind_host, port or (443 if parsed.scheme == "https" else 80)


def gui_environment():
    text = checked(["systemctl", "--user", "show-environment"], "gui_unavailable",
                   output_limit=MAX_INVENTORY_OUTPUT)
    imported = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)
    gui = {key: value for key, value in os.environ.items() if key not in GUI_KEYS}
    gui.update({key: imported[key] for key in GUI_KEYS if key in imported})
    runtime = imported.get("XDG_RUNTIME_DIR")
    bus = imported.get("DBUS_SESSION_BUS_ADDRESS")
    if not runtime or not os.path.isabs(runtime) or not bus:
        fail("gui_unavailable", "systemd user environment has no runtime dir or session bus")
    text = checked(["loginctl", "show-user", str(os.getuid()), "-p", "Display", "-p", "Sessions"],
                   "gui_unavailable", output_limit=MAX_INVENTORY_OUTPUT)
    user = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)
    session = user.get("Display", "")
    sessions = user.get("Sessions", "").split()
    if not session or session not in sessions or any(not re.fullmatch(r"[A-Za-z0-9_-]+", item) for item in sessions):
        fail("gui_unavailable", "no identified local GUI session")
    graphical = []
    for candidate in sessions:
        properties = checked(["loginctl", "show-session", candidate, "-p", "Active", "-p", "Remote",
                              "-p", "Type", "-p", "Class", "-p", "User"], "gui_unavailable",
                             output_limit=MAX_INVENTORY_OUTPUT)
        details = dict(line.split("=", 1) for line in properties.splitlines() if "=" in line)
        if (details.get("Active") == "yes" and details.get("Remote") == "no" and
                details.get("Class") == "user" and details.get("User") == str(os.getuid()) and
                details.get("Type") in ("x11", "wayland")):
            graphical.append((candidate, details["Type"]))
    if len(graphical) != 1 or graphical[0][0] != session or imported.get("XDG_SESSION_TYPE") != graphical[0][1]:
        fail("gui_unavailable", "systemd environment does not identify one active local GUI session")
    kind = graphical[0][1]
    if kind == "x11":
        if not imported.get("DISPLAY") or not imported.get("XAUTHORITY"):
            fail("gui_unavailable", "active X11 display/authority is missing")
        checked(["xset", "q"], "gui_unavailable", env=gui, timeout=4)
    else:
        wayland = imported.get("WAYLAND_DISPLAY")
        if not wayland or "/" in wayland:
            fail("gui_unavailable", "active Wayland socket is missing")
        try:
            with socket.socket(socket.AF_UNIX) as probe:
                probe.settimeout(2)
                probe.connect(os.path.join(runtime, wayland))
        except OSError as error:
            fail("gui_unavailable", f"Wayland compositor is unreachable: {error}")
    return gui, runtime


def private_state(runtime):
    root = Path(runtime)
    try:
        info = root.stat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            fail("invalid_state", "XDG_RUNTIME_DIR must be a private directory owned by this user")
        directory = root / "pi-client-link-helper"
        directory.mkdir(mode=0o700, exist_ok=True)
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
            fail("invalid_state", "helper state directory is not private")
        lock_fd = os.open(directory / "lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        info = os.fstat(lock_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
            os.close(lock_fd)
            fail("invalid_state", "helper lock is not private")
        return directory, lock_fd
    except OSError as error:
        fail("invalid_state", f"cannot create private runtime state: {error}")


def ssh_identity():
    text = checked(["ssh", "-G", SSH_ALIAS], "ssh_config_failed", timeout=8,
                   output_limit=MAX_INVENTORY_OUTPUT)
    # A DNS name or repeated field cannot be compared to the exact endpoint of
    # the later master; do not silently resolve or pick an arbitrary ssh-G value.
    values = {key: [] for key in ("hostname", "user", "port")}
    for line in text.splitlines():
        key, _, value = line.partition(" ")
        if key in values:
            values[key].append(value)
    if any(len(entries) != 1 for entries in values.values()):
        fail("ssh_config_failed", "configured SSH alias has ambiguous hostname/user/port")
    host, user, port = (values[key][0] for key in ("hostname", "user", "port"))
    try:
        literal = ipaddress.ip_address(host)
    except ValueError:
        fail("ssh_config_failed", "configured SSH HostName must be a literal IP address")
    if (str(literal) != host or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*", user) or
            not port.isdecimal() or not 1 <= int(port) <= 65535):
        fail("ssh_config_failed", "configured SSH alias has non-comparable hostname/user/port")
    return {"host": host, "user": user, "port": int(port)}


def mux_args(socket_path, operation, identity):
    return ["ssh", "-F", "/dev/null", "-S", str(socket_path), "-O", operation,
            "-o", "BatchMode=yes", "-p", str(identity["port"]), "-l", identity["user"], identity["host"]]


def master_pid(socket_path, identity):
    status, text = run(mux_args(socket_path, "check", identity), timeout=6)
    if status:
        return None
    match = PID_RE.search(text)
    if not match:
        fail("tunnel_unverified", "SSH master check returned no process identity")
    return int(match.group(1))


def listeners():
    text = checked(["ss", "-H", "-ltnp"], "tunnel_unverified", timeout=5,
                   output_limit=MAX_INVENTORY_OUTPUT)
    found = []
    for line in text.splitlines():
        columns = line.split(maxsplit=5)
        if len(columns) < 5 or columns[0] != "LISTEN":
            continue
        try:
            host, port = columns[3].rsplit(":", 1)
            port = int(port)
        except ValueError:
            fail("tunnel_unverified", "unrecognized ss listener address")
        host = host.strip("[]")
        try:
            host = str(ipaddress.ip_address(host))
        except ValueError:
            pass
        found.append((host, port, {int(pid) for pid in SS_PID_RE.findall(line)}))
    return found


def covers_host(listener_host, bind_host):
    if bind_host == "localhost" or listener_host == bind_host or listener_host in ("*", "0.0.0.0", "::"):
        return True
    try:
        listener = ipaddress.ip_address(listener_host)
        target = ipaddress.ip_address(bind_host)
    except ValueError:
        return False
    return (getattr(listener, "ipv4_mapped", None) or listener) == (getattr(target, "ipv4_mapped", None) or target)


def port_occupied(bind_host, port):
    return any(number == port and covers_host(host, bind_host) for host, number, _ in listeners())


def owns_listener(bind_host, port, pid):
    relevant = [(host, pids) for host, number, pids in listeners()
                if number == port and covers_host(host, bind_host)]
    return (any(host == bind_host and pid in pids for host, pids in relevant) and
            all(pid in pids for _, pids in relevant))


def record_path(directory, host, port):
    digest = hashlib.sha256(f"{host}\0{port}".encode()).hexdigest()[:32]
    return directory / f"e-{digest}.json"


def load_record(path, directory, endpoint, identity):
    try:
        info = path.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > 4096:
        fail("invalid_state", "tunnel record is not a private regular file")
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        fail("invalid_state", f"unreadable tunnel record: {error}")
    if isinstance(data, dict) and data.get("version") == 1:
        fail("tunnel_unverified", "old unpinned tunnel record must be retired before reuse")
    if (not isinstance(data, dict) or set(data) != {"version", "endpoint", "identity", "local_port", "socket", "pid"} or
            data["version"] != 2 or data["endpoint"] != endpoint or data["identity"] != identity or
            type(data["local_port"]) is not int or not 1 <= data["local_port"] <= 65535 or
            type(data["pid"]) is not int or data["pid"] <= 0 or
            not isinstance(data["socket"], str) or Path(data["socket"]).parent != directory or
            not SOCKET_NAME_RE.fullmatch(Path(data["socket"]).name)):
        fail("invalid_state", "tunnel record does not match the exact owned endpoint/SSH identity")
    return data


def save_record(path, data):
    fd, name = tempfile.mkstemp(prefix="record-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as output:
            json.dump(data, output)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(name, 0o600)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def stale_socket(socket_path):
    try:
        info = socket_path.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
        fail("invalid_state", "stale SSH control path is not an owned socket")
    socket_path.unlink()


def can_bind_preferred(bind_host, port):
    family = socket.AF_INET6 if ":" in bind_host else socket.AF_INET
    with socket.socket(family) as probe:
        try:
            probe.bind((bind_host, port))
        except OSError as error:
            if error.errno in (errno.EACCES, errno.EADDRINUSE):
                return False
            fail("ssh_forward_failed", f"local loopback bind preflight failed: {error}")
    return True


def forward_spec(bind_host, local_port, remote_port):
    address = f"[{bind_host}]" if ":" in bind_host else bind_host
    return f"{address}:{local_port}:{address}:{remote_port}"


def port_conflict(bind_host, port):
    authority = f"[{bind_host}]" if ":" in bind_host else bind_host
    fail("port_conflict", f"Y9000p loopback port {authority}:{port} is occupied or cannot be bound; "
                          "remove the conflicting listener and retry the original URL")


def owned_forward(directory, bind_host, remote_port, identity):
    endpoint = {"host": bind_host, "port": remote_port}
    path = record_path(directory, bind_host, remote_port)
    data = load_record(path, directory, endpoint, identity)
    if data:
        sock = Path(data["socket"])
        pid = master_pid(sock, identity)
        if pid is not None:
            if data["local_port"] != remote_port:
                port_conflict(bind_host, remote_port)
            if pid != data["pid"] or not owns_listener(bind_host, remote_port, pid):
                fail("tunnel_unverified", "live SSH master does not own its recorded exact loopback listener")
            return True
        stale_socket(sock)
        path.unlink()

    # A listener covering this exact client IP (including wildcard/mapped
    # bindings) conflicts. Never make an alternate browser origin.
    if (port_occupied(bind_host, remote_port) or
            (remote_port < 1024 and not can_bind_preferred(bind_host, remote_port))):
        port_conflict(bind_host, remote_port)
    sock = directory / ("m-" + os.urandom(12).hex() + ".sock")
    checked(["ssh", "-M", "-S", str(sock), "-fN", "-o", "ClearAllForwardings=yes",
             "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes", "-o", "ConnectTimeout=8",
             "-o", "StrictHostKeyChecking=yes", "-o", f"HostName={identity['host']}",
             "-o", f"User={identity['user']}", "-o", f"Port={identity['port']}",
             SSH_ALIAS], "ssh_master_failed", timeout=12)
    try:
        pid = master_pid(sock, identity)
        if pid is None:
            fail("ssh_master_failed", "new SSH master is not alive")
        args = mux_args(sock, "forward", identity)
        args[args.index("-p"):args.index("-p")] = [
            "-o", "ExitOnForwardFailure=yes", "-L",
            forward_spec(bind_host, remote_port, remote_port)]
        status, text = run(args, timeout=8)
        if status:
            if (port_occupied(bind_host, remote_port) or
                    (remote_port < 1024 and not can_bind_preferred(bind_host, remote_port))):
                port_conflict(bind_host, remote_port)
            fail("ssh_forward_failed", f"SSH forward exited {status}: {text or 'no diagnostic'}")
        if master_pid(sock, identity) != pid or not owns_listener(bind_host, remote_port, pid):
            fail("tunnel_unverified", "SSH forward returned success without an owned exact-port loopback listener")
        data = {"version": 2, "endpoint": endpoint, "identity": identity,
                "local_port": remote_port, "socket": str(sock), "pid": pid}
        save_record(path, data)
        return False
    except BaseException:
        try:
            run(mux_args(sock, "exit", identity), timeout=6)
            for _ in range(20):
                if master_pid(sock, identity) is None:
                    break
                time.sleep(0.05)
            else:
                fail("ssh_cleanup_failed", f"private SSH master did not exit: {sock}")
            stale_socket(sock)
        except LinkError as error:
            fail("ssh_cleanup_failed", f"cannot close private SSH master {sock}: {error}")
        raise


def prepare_web(raw, runtime, peer, deadline):
    _, bind_host, remote_port = web_target(raw)
    if bind_host == "localhost":
        if port_occupied(bind_host, remote_port):
            port_conflict(bind_host, remote_port)
        fail("unsupported_target", "localhost requires dual-stack, hostname-preserving forwarding; "
                                   "this is not available until the next stage")
    if bind_host is None:
        tunnel = None
    else:
        directory, lock_fd = private_state(runtime)
        try:
            while True:
                peer.alive(deadline)
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    time.sleep(min(0.05, max(0, deadline - time.monotonic())))
            peer.alive(deadline)
            identity = ssh_identity()
            reused = owned_forward(directory, bind_host, remote_port, identity)
        finally:
            os.close(lock_fd)
        tunnel = {"remoteHost": bind_host, "remotePort": remote_port,
                  "localPort": remote_port, "reused": reused}
    return {"ok": True, "action": "open-web", "openedUrl": raw, "tunnel": tunnel}


def file_target(data):
    path = data["path"]
    if not 0 < len(path) <= 4096 or "\0" in path or not PurePosixPath(path).is_absolute():
        fail("unsupported_target", "company path must be a nonempty absolute POSIX path")
    if "line" in data and ":" in path:
        fail("unsupported_target", "Code goto cannot preserve a colon-containing filename")


def file_command(data):
    path = data["path"]
    # VS Code cannot stat a remote positional path and guesses by its basename.
    # The company-side kind selects its typed resource resolver instead.
    target = quote(path, safe="/")
    args = ["code", "--remote", REMOTE_CODE, "--new-window"]
    if "line" in data:
        args.append("--goto")
        target += f":{data['line']}"
        if "column" in data:
            target += f":{data['column']}"
    uri = f"vscode-remote://{REMOTE_CODE}{target}"
    args.extend(["--file-uri" if data["kind"] == "file" else "--folder-uri", uri])
    return args, {"ok": True, "action": "open-file", "path": path, "kind": data["kind"]}


def emit(response):
    print(json.dumps(response, ensure_ascii=False, separators=(",", ":")), flush=True)


def main():
    try:
        peer = Peer()
        data, deadline = request(peer)
        # Validate the exact target before touching GUI or transport state.
        if data["action"] == "open-web":
            web_target(data["url"])
        else:
            file_target(data)
        peer.alive(deadline)
        gui, runtime = gui_environment()
        peer.alive(deadline)
        response = prepare_web(data["url"], runtime, peer, deadline) if data["action"] == "open-web" else file_command(data)[1]
        peer.alive(deadline)
        nonce = os.urandom(16).hex()
        emit({"version": 2, "phase": "prepared", "nonce": nonce, **response})
        commit = peer.line(deadline, "COMMIT")
        if (not isinstance(commit, dict) or set(commit) != {"version", "phase", "nonce"} or
                type(commit["version"]) is not int or commit["version"] != 2 or
                commit["phase"] != "commit" or commit["nonce"] != nonce):
            fail("invalid_commit", "expected the matching version 2 COMMIT")
        # This check is the handoff boundary: once accepted, a later company-side
        # timeout may not revoke the desktop request. Do not launch on buffered
        # duplicate messages or an already disconnected transport.
        peer.alive(deadline)
        if data["action"] == "open-web":
            checked(["xdg-open", response["openedUrl"]], "browser_failed", env=gui, timeout=12)
        else:
            checked(file_command(data)[0], "code_failed", env=gui, timeout=12)
        status = 0
    except LinkError as error:
        response, status = {"ok": False, "error": {"code": error.code, "message": str(error)}}, 1
    except (OSError, ValueError) as error:
        response, status = {"ok": False, "error": {"code": "runtime_failed", "message": str(error)}}, 1
    emit({"version": 2, "phase": "result", **response})
    return status


if __name__ == "__main__":
    sys.exit(main())
